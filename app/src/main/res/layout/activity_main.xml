<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    tools:context=".MainActivity">

    <!-- Fragment Container View -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Trang chủ -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/account_balance_24px"
                app:tint="#0B63E5" />

            <TextView
                android:id="@+id/txtNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Trang chủ"
                android:textColor="#0B63E5"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Tài khoản -->
        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavAccount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/person_24px"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/txtNavAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tài khoản"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Khoảng trống chừa chỗ cho nút tròn giữa -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Tab 3: Tiện ích -->
        <LinearLayout
            android:id="@+id/navUtilities"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavUtilities"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/receipt"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/txtNavUtilities"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tiện ích"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Chatbot -->
        <LinearLayout
            android:id="@+id/navAI"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNavAI"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/chat_bubble_24px"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/txtNavAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Nova AI"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Floating Center Button -->
    <ImageButton
        android:id="@+id/btnCenter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn"
        android:elevation="12dp"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:src="@drawable/arrow_outward"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bottomNav"
        app:tint="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <!-- Header Background -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_header_dark_green"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar Content -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/stars_2"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="NOVA"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/imgLogo"
        app:layout_constraintStart_toEndOf="@+id/imgLogo"
        app:layout_constraintTop_toTopOf="@+id/imgLogo" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cấu hình hệ thống"
            android:textColor="#1E293B"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cài đặt Lãi suất tiết kiệm"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F4C3A"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỳ hạn 1 tháng (%)"
                android:textSize="14sp"
                android:textColor="#64748B"/>
            <EditText
                android:id="@+id/etInterest1M"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="16dp"
                android:text="4.5"
                android:inputType="numberDecimal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỳ hạn 6 tháng (%)"
                android:textSize="14sp"
                android:textColor="#64748B"/>
            <EditText
                android:id="@+id/etInterest6M"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="16dp"
                android:text="6.5"
                android:inputType="numberDecimal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kỳ hạn 12 tháng (%)"
                android:textSize="14sp"
                android:textColor="#64748B"/>
            <EditText
                android:id="@+id/etInterest12M"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:paddingHorizontal="16dp"
                android:text="7.2"
                android:inputType="numberDecimal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnSaveConfig"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Cập nhật cấu hình"
                android:backgroundTint="#0F4C3A"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnDone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imgStatus"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/verified_user_24px"
                app:tint="#059669"
                android:background="@drawable/bg_icon_green"
                android:padding="16dp"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thanh toán thành công"
                android:textColor="#059669"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450.000 VND"
                android:textColor="#1E293B"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="32dp"/>

            <!-- Receipt Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:padding="20dp"
                android:elevation="2dp">

                <!-- Dynamic fields will be added programmatically or toggled -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Mã giao dịch"
                        android:textColor="#64748B"/>
                    <TextView
                        android:id="@+id/tvTransId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FT23120912"
                        android:textColor="#1E293B"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Thời gian"
                        android:textColor="#64748B"/>
                    <TextView
                        android:id="@+id/tvTransDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14:30 12/06/2024"
                        android:textColor="#1E293B"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Dịch vụ"
                        android:textColor="#64748B"/>
                    <TextView
                        android:id="@+id/tvTransService"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thanh toán tiền điện"
                        android:textColor="#1E293B"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Nhà cung cấp"
                        android:textColor="#64748B"/>
                    <TextView
                        android:id="@+id/tvTransProvider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EVN HCMC"
                        android:textColor="#1E293B"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F1F5F9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Tài khoản trích nợ"
                        android:textColor="#64748B"/>
                    <TextView
                        android:id="@+id/tvTransSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0098****2846"
                        android:textColor="#1E293B"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="24dp"
        android:text="Về màn hình chính"
        android:backgroundTint="#0F4C3A"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
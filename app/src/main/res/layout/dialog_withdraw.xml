<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rút tiền"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tài khoản nguồn"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input_stroke"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/account_balance_24px"
            android:layout_marginEnd="12dp"
            app:tint="#0F4C3A"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản thanh toán"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="48.256.000đ"
                android:textSize="12sp"
                android:textColor="#64748B"/>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/arrow_forward_ios"
            app:tint="#94A3B8"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rút về ngân hàng"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_marginBottom="8dp"/>

    <!-- Fake Spinner/Dropdown for Bank Selection -->
    <LinearLayout
        android:id="@+id/llBankSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input_stroke"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgBankLogo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/apartment_24px"
            android:layout_marginEnd="12dp"
            app:tint="#0F4C3A"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvBankName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn ngân hàng nhận"
                android:textSize="14sp"
                android:textColor="#1E293B"
                android:textStyle="bold"/>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/arrow_forward_ios"
            android:rotation="90"
            app:tint="#94A3B8"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etBankAccountNumber"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Số tài khoản nhận"
        android:background="@drawable/bg_input_stroke"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:inputType="number"
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:hint="Nhập số tiền cần rút (VND)"
        android:background="@drawable/bg_input_stroke"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:inputType="numberDecimal"
        android:textSize="16sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="Hủy"
            android:backgroundTint="@color/transparent"
            android:background="@drawable/bg_btn_secondary"
            android:textColor="#64748B"
            android:layout_marginEnd="16dp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Xác nhận"
            android:backgroundTint="@color/transparent"
            android:background="@drawable/bg_btn_primary"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>